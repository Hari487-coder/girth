{
  "name": "@girth/api",
  "private": true,
  "version": "0.2.0",
  "description": "Girth API: identity, measurement, verification, audits, payment ledger.",
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../../packages/domain run build",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "pretest": "npm --prefix ../../packages/domain run build && prisma generate",
    "test": "vitest run",
    "db:up": "tsx scripts/db-up.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@girth/domain": "*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.0"
  }
}
