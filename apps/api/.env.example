# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Local embedded Postgres started by `npm run db:up`
DATABASE_URL=postgresql://girth:girth@127.0.0.1:5433/girth

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-character-hex-string-before-running-1234

WEB_ORIGINS=http://localhost:3200
PUBLIC_TREE_BASE_URL=http://localhost:3200

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

AUDIT_SAMPLING_SALT=replace-with-a-random-string

# Seed admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@girth.local
SEED_ADMIN_PASSWORD=change-this-admin-password
