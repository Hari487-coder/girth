# Copy to deploy/.env on the server. Never commit deploy/.env.
# Generate secrets: openssl rand -hex 32

# Public hostname Caddy will obtain a certificate for. With no DNS yet, use
# sslip.io: girth.<ip-with-dashes>.sslip.io, e.g. girth.203-0-113-5.sslip.io
GIRTH_DOMAIN=girth.example.com
APP_ENV=staging

POSTGRES_PASSWORD=
SESSION_SECRET=
AUDIT_SAMPLING_SALT=

S3_BUCKET=girth-evidence
S3_ACCESS_KEY_ID=girth
S3_SECRET_ACCESS_KEY=

# First boot only: seed demo accounts and trees, then set back to false
SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@girth.local
SEED_ADMIN_PASSWORD=

# Shared front proxy network on the host (see docker-compose.staging.yml).
# Create it once with `docker network create edge` if it does not exist.
EDGE_NETWORK=edge

# Only used with `--profile standalone` (this stack's own Caddy)
HTTP_PORT=80
HTTPS_PORT=443
